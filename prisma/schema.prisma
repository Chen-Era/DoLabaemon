generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LabRole {
  PI
  ADMIN
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReagentCategory {
  ANTIBODY
  BUFFER
  KIT
  PRIMER
  BIOLOGICAL
  CHEMICAL
  CONSUMABLE
  OTHER
}

enum AntibodyRole {
  PRIMARY
  SECONDARY
}

enum RuleLevel {
  MIN_REQUIRED
  RECOMMENDED
}

enum RuleMatcherType {
  TAG_ANY
  NAME_ANY
  ANTIBODY_TARGET_ANY
  PRIMER_TARGET_ANY
  PRIMER_REFERENCE
}

enum TechniqueStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  DEPRECATED
}

enum TechniqueSource {
  SYSTEM
  CURATED
  AI_DRAFT
}

enum TechniqueDraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum TechniqueRequirementKind {
  REAGENT
  CONSUMABLE
  INSTRUMENT
  SAMPLE
  CONTROL
  SOFTWARE
}

enum TechniqueRequirementLevel {
  REQUIRED
  RECOMMENDED
  CONDITIONAL
}

enum TechniqueVerificationMode {
  AUTO_INVENTORY
  MANUAL_CONFIRMATION
}

model User {
  id                 String                        @id @default(cuid())
  email              String                        @unique
  passwordHash       String
  displayName        String?
  createdAt          DateTime                      @default(now())
  memberships        LabMember[]
  joinRequests       LabJoinRequest[]
  llmConfig          UserLlmConfig?
  knowledgeLogs      KnowledgeMutationLog[]
  techniqueDrafts    ExperimentTechniqueDraft[]    @relation("TechniqueDraftCreator")
  techniqueReviews   ExperimentTechniqueDraft[]    @relation("TechniqueDraftReviewer")
  techniqueRevisions ExperimentTechniqueRevision[] @relation("TechniqueRevisionPublisher")
}

model UserLlmConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  openaiApiKey      String?
  openaiBaseUrl     String?
  openaiModel       String?
  openaiVisionModel String?
  searchEnabled     Boolean  @default(true)
  searchProvider    String?
  searchApiKey      String?
  searchBaseUrl     String?
  enabledSkills     String[] @default([])
  enabledMcpServers String[] @default([])
  selfCheckEnabled  Boolean  @default(true)
  autoLearnEnabled  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lab {
  id                 String                        @id @default(cuid())
  name               String
  members            LabMember[]
  joinRequests       LabJoinRequest[]
  reagents           Reagent[]
  checks             ExperimentCheckRun[]
  invitations        Invitation[]
  aiPolicy           LabAiPolicy?
  knowledgeLogs      KnowledgeMutationLog[]
  techniqueDrafts    ExperimentTechniqueDraft[]
  techniqueRevisions ExperimentTechniqueRevision[]
}

model LabMember {
  id     String  @id @default(cuid())
  userId String
  labId  String
  role   LabRole @default(MEMBER)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab    Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
}

model LabJoinRequest {
  id         String            @id @default(cuid())
  labId      String
  userId     String
  message    String?
  status     JoinRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?
  reviewerId String?
  lab        Lab               @relation(fields: [labId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([labId, status])
  @@index([userId, status])
}

model Invitation {
  id          String   @id @default(cuid())
  labId       String
  email       String
  role        LabRole  @default(MEMBER)
  invitedById String
  expiresAt   DateTime
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model Reagent {
  id               String          @id @default(cuid())
  labId            String
  name             String
  catalogNo        String
  vendor           String?
  category         ReagentCategory
  subCategory      String?
  storageCondition String?
  expiryDate       DateTime?
  quantity         Float?
  unit             String?
  arrivalDate      DateTime?
  note             String?
  experimentTags   String[]        @default([])
  createdAt        DateTime        @default(now())
  lab              Lab             @relation(fields: [labId], references: [id], onDelete: Cascade)
  antibodyMeta     AntibodyMeta?
  primerMeta       PrimerMeta?

  @@unique([labId, catalogNo])
}

model AntibodyMeta {
  id            String       @id @default(cuid())
  reagentId     String       @unique
  role          AntibodyRole
  hostSpecies   String?
  targetSpecies String?
  targetName    String?
  reagent       Reagent      @relation(fields: [reagentId], references: [id], onDelete: Cascade)
}

model PrimerMeta {
  id              String  @id @default(cuid())
  reagentId       String  @unique
  targetName      String?
  isReferenceGene Boolean @default(false)
  reagent         Reagent @relation(fields: [reagentId], references: [id], onDelete: Cascade)
}

model ExperimentType {
  id     String           @id @default(cuid())
  code   String           @unique
  nameZh String
  nameEn String
  rules  ExperimentRule[]
}

model ResearchDirection {
  id     String           @id @default(cuid())
  code   String           @unique
  nameZh String
  nameEn String
  rules  ExperimentRule[]
}

model ExperimentRule {
  id                  String             @id @default(cuid())
  experimentTypeId    String
  researchDirectionId String?
  level               RuleLevel
  displayNameZh       String
  displayNameEn       String
  requiredKeywords    String[]
  matcherType         RuleMatcherType    @default(NAME_ANY)
  matcherValues       String[]           @default([])
  matcherAntibodyRole AntibodyRole?
  experimentType      ExperimentType     @relation(fields: [experimentTypeId], references: [id], onDelete: Cascade)
  researchDirection   ResearchDirection? @relation(fields: [researchDirectionId], references: [id], onDelete: SetNull)
}

model ReagentParseDraft {
  id           String   @id @default(cuid())
  labId        String
  userId       String
  rawInput     Json
  parsedOutput Json
  confidence   Float?
  warnings     String[]
  isConfirmed  Boolean  @default(false)
}

model ExperimentResolveDraft {
  id               String   @id @default(cuid())
  labId            String
  userId           String
  rawInput         Json
  resolvedOutput   Json
  resolutionSource String
  confidence       Float?
  warnings         String[]
  isConfirmed      Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model ExperimentCheckRun {
  id                  String                @id @default(cuid())
  labId               String
  userId              String
  experimentCode      String
  directionCode       String?
  profileCode         String?
  techniqueRevision   Int?
  confirmedRequirementIds String[]              @default([])
  prerequisite        String?
  confidenceLabel     String
  status              String
  warnings            String[]
  compatibilityIssues String[]
  createdAt           DateTime              @default(now())
  lab                 Lab                   @relation(fields: [labId], references: [id], onDelete: Cascade)
  items               ExperimentCheckItem[]
}

model ExperimentCheckItem {
  id          String             @id @default(cuid())
  checkRunId  String
  level       RuleLevel
  requirementId String?
  requirementKind String?
  requirementLevel String?
  verificationMode String?
  state String?
  displayName String
  isMissing   Boolean
  matchedName String?
  checkRun    ExperimentCheckRun @relation(fields: [checkRunId], references: [id], onDelete: Cascade)
}

model LabAiPolicy {
  id                      String    @id @default(cuid())
  labId                   String    @unique
  allowAutoLearn          Boolean   @default(false)
  allowedRoles            LabRole[] @default([PI])
  enabledKnowledgeDomains String[]  @default(["REAGENT", "EXPERIMENT"])
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lab                     Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model KnowledgeMutationLog {
  id              String    @id @default(cuid())
  labId           String
  userId          String
  flowType        String
  domain          String
  entityKey       String
  status          String
  beforeData      Json?
  afterData       Json?
  evidenceSummary String[]
  modelName       String?
  rolledBackAt    DateTime?
  createdAt       DateTime  @default(now())
  lab             Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([labId, createdAt])
  @@index([userId, createdAt])
}

model ReagentKnowledgeEntry {
  id               String          @id
  canonicalName    String
  aliases          String[]        @default([])
  category         ReagentCategory
  subCategory      String?
  experimentTags   String[]        @default([])
  namePatterns     String[]        @default([])
  requiredKeywords String[]        @default([])
  excludedKeywords String[]        @default([])
  vendorHints      String[]        @default([])
  evidenceType     String
  confidenceHint   Float
  notes            String?
  source           String          @default("SYSTEM")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([canonicalName])
}

model ExperimentKnowledgeEntry {
  id                          String   @id
  canonicalName               String
  aliases                     String[] @default([])
  normalizedCode              String
  descriptionZh               String
  descriptionEn               String
  supportedDirections         String[] @default([])
  workflowStages              Json
  requiredReagentTemplates    Json
  recommendedReagentTemplates Json
  evidenceKeywords            String[] @default([])
  excludedKeywords            String[] @default([])
  relatedExperimentTags       String[] @default([])
  source                      String   @default("SYSTEM")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([canonicalName])
  @@index([normalizedCode])
}

model ExperimentTechnique {
  id                     String                        @id @default(cuid())
  code                   String                        @unique
  slug                   String                        @unique
  revision               Int                           @default(1)
  status                 TechniqueStatus
  source                 TechniqueSource
  contentHash            String
  isAbstract             Boolean                       @default(false)
  parentCode             String?
  nameZh                 String
  nameEn                 String
  aliases                String[]                      @default([])
  categoryCode           String
  subcategoryCode        String
  principleZh            String
  principleEn            String
  scopeZh                String
  scopeEn                String
  sampleTypes            String[]                      @default([])
  inputTypes             String[]                      @default([])
  outputTypes            String[]                      @default([])
  readoutModes           String[]                      @default([])
  throughput             String
  destructive            Boolean                       @default(false)
  workflowStages         Json
  keyParameters          Json
  qcMetrics              Json
  limitations            Json
  troubleshooting        Json
  safety                 Json
  ontologyMappings       Json
  ontologyUnmappedReason Json?
  reportingStandards     Json
  evidenceSourceIds      String[]                      @default([])
  claimEvidence          Json
  resolutionExamples     Json
  reviewedAt             DateTime
  nextReviewDue          DateTime
  active                 Boolean                       @default(true)
  formalPublication      Boolean                       @default(false)
  curationWarnings       String[]                      @default([])
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  requirements           TechniqueRequirement[]
  profiles               ExperimentTechniqueProfile[]
  evidenceBindings       TechniqueEvidenceBinding[]
  revisions              ExperimentTechniqueRevision[]

  @@index([status, active])
  @@index([categoryCode, subcategoryCode])
  @@index([parentCode])
}

model TechniqueRequirement {
  id               String                      @id
  techniqueId      String
  profileId        String?
  kind             TechniqueRequirementKind
  level            TechniqueRequirementLevel
  verificationMode TechniqueVerificationMode
  labelZh          String
  labelEn          String
  capabilityTags   String[]                    @default([])
  matcherValues    String[]                    @default([])
  condition        Json?
  sortOrder        Int                         @default(0)
  technique        ExperimentTechnique         @relation(fields: [techniqueId], references: [id], onDelete: Cascade)
  profile          ExperimentTechniqueProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([techniqueId, kind, level])
  @@index([profileId])
}

model ExperimentTechniqueProfile {
  id                     String                 @id @default(cuid())
  techniqueId            String
  code                   String
  name                   Json
  description            Json
  technique              ExperimentTechnique    @relation(fields: [techniqueId], references: [id], onDelete: Cascade)
  additionalRequirements TechniqueRequirement[]

  @@unique([techniqueId, code])
}

model EvidenceSource {
  id                String                     @id
  title             String
  organization      String
  sourceType        String
  tier              String
  authorityScope    String
  canonicalUrl      String
  version           String
  versionUri        String
  releaseDate       String
  retrievedAt       DateTime
  licenseId         String
  licenseUrl        String?
  reuseMode         String
  doi               String?
  pmid              String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  techniqueBindings TechniqueEvidenceBinding[]

  @@index([tier, sourceType])
}

model TechniqueEvidenceBinding {
  id               String              @id @default(cuid())
  techniqueId      String
  evidenceSourceId String
  supportedFields  String[]            @default([])
  claimLocator     String?
  technique        ExperimentTechnique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)
  evidenceSource   EvidenceSource      @relation(fields: [evidenceSourceId], references: [id], onDelete: Restrict)

  @@unique([techniqueId, evidenceSourceId])
  @@index([evidenceSourceId])
}

model ExperimentTechniqueRevision {
  id                   String              @id @default(cuid())
  techniqueId          String
  revision             Int
  snapshot             Json
  contentHash          String
  changeSummary        String
  restoredFromRevision Int?
  labId                String?
  publishedById        String?
  createdAt            DateTime            @default(now())
  technique            ExperimentTechnique @relation(fields: [techniqueId], references: [id], onDelete: Restrict)
  lab                  Lab?                @relation(fields: [labId], references: [id], onDelete: SetNull)
  publishedBy          User?               @relation("TechniqueRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([techniqueId, revision])
  @@index([labId, createdAt])
}

model ExperimentTechniqueDraft {
  id           String               @id @default(cuid())
  labId        String
  createdById  String
  baseCode     String?
  baseRevision Int?
  status       TechniqueDraftStatus @default(DRAFT)
  source       TechniqueSource      @default(CURATED)
  payload      Json
  reviewerId   String?
  reviewNote   String               @default("")
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  lab          Lab                  @relation(fields: [labId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("TechniqueDraftCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reviewer     User?                @relation("TechniqueDraftReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([labId, status, updatedAt])
  @@index([baseCode])
}
