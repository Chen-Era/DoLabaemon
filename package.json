{
  "name": "lab-reagent-system",
  "version": "0.1.1",
  "description": "Dorlabaemon laboratory reagent management desktop client",
  "author": "Era",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node scripts/run-tests-isolated.mjs",
    "knowledge:validate": "tsx scripts/knowledge-validate.ts",
    "knowledge:sync": "tsx scripts/knowledge-sync.ts",
    "knowledge:hermes-sync": "tsx scripts/hermes-knowledge-sync.ts",
    "desktop:dev": "electron .",
    "desktop:test": "node --test desktop/url-policy.test.cjs",
    "desktop:verify": "node desktop/verify-desktop-build.cjs",
    "desktop:dist:mac": "node desktop/prepare-build-assets.cjs --mac && npm run desktop:verify -- --mac && electron-builder --config electron-builder.yml --mac",
    "desktop:dist:win": "node desktop/prepare-build-assets.cjs --win && npm run desktop:verify -- --win && electron-builder --config electron-builder.yml --win"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.3",
    "next": "16.2.3",
    "next-auth": "^4.24.13",
    "openai": "^6.34.0",
    "prisma": "^6.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
